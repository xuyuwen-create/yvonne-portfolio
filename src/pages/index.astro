---
import SpritePortrait from '../components/SpritePortrait.astro';
import SceneMenu from '../components/SceneMenu.astro';
import ProjectsScene from '../components/ProjectsScene.astro';
import CursorGlow from '../components/CursorGlow.astro';
import InterestsScene from '../components/InterestsScene.astro';
import PendingScene from '../components/PendingScene.astro';
import MeteorBackdrop from '../components/MeteorBackdrop.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Yvonneのポートフォリオです。これまでの歩み、できること、好きなこと、制作実績をご紹介します。"
    />
    <title>Yvonne｜ポートフォリオ</title>
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.homeEntrance = 'pending';
        setTimeout(() => delete document.documentElement.dataset.homeEntrance, 4000);
      }
    </script>
  </head>
  <body>
    <main class="app">
      <MeteorBackdrop />
      <header class="app__header">
        <button
          class="app__brand"
          type="button"
          data-back-home
          aria-label="YVONNE ポートフォリオ：ホームへ"
        >
          YVONNE<span>ポートフォリオ</span>
        </button>
        <span class="app__edition">ポートフォリオ / 01</span>
      </header>
      <div class="scenes">
        <section id="home-scene" class="home scene" aria-label="ポートフォリオのホーム">
          <div class="home__stage">
            <div class="home__copy">
              <p class="home__eyebrow">Frontend Development</p>
              <h1 class="home__title">
                <span>YVONNE</span>
                <span>の世界へ</span>
                <span>ようこそ</span>
              </h1>
              <p class="home__intro">
                これまでの歩みや、できること、好きなこと。
                <br />
                仕事や制作のことも、ここでご紹介します。
              </p>
            </div>
            <div class="home__portrait">
              <SpritePortrait />
            </div>
            <SceneMenu />
            <div class="home__tracking-area" data-portrait-area aria-hidden="true"></div>
          </div>
        </section>
        <ProjectsScene />
        <InterestsScene />
        <PendingScene />
      </div>
      <footer class="app__footer">
        <span>歩み・想い・ものづくり</span>
        <span id="menu-note">人物イラストはAIで生成した素材を使用しています。</span>
      </footer>
    </main>
    <CursorGlow />
  </body>
</html>

<script>
  import '../scripts/scenes';
  import '../scripts/homeEntrance';
</script>
