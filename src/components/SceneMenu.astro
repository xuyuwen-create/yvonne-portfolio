---
import { withBase } from '../utils/paths';
const entries = [
  {
    id: 'experience',
    name: '個人経歴',
    number: '01',
    imageSrc: '/images/menu-buttons/about.webp',
  },
  {
    id: 'skills',
    name: 'できること',
    number: '02',
    imageSrc: '/images/menu-buttons/skills.webp',
  },
  {
    id: 'interests',
    name: '好きなこと',
    number: '03',
    imageSrc: '/images/menu-buttons/blog.webp',
  },
  {
    id: 'projects',
    name: '制作実績',
    number: '04',
    imageSrc: '/images/menu-buttons/works.webp',
  },
  {
    id: 'misc',
    name: 'あれこれ',
    number: '05',
    imageSrc: '/images/menu-buttons/more.webp',
  },
];
---

<nav class="scene-menu" aria-label="ポートフォリオのメニュー">
  {entries.map(({ id, name, number, imageSrc }) => (
    <button
      class={`scene-menu__entry scene-menu__entry--${id}`}
      type="button"
      data-scene={id}
      aria-label={id !== 'projects' ? `${name}（準備中）` : name}
      aria-controls={id === 'projects' ? 'projects-scene' : 'pending-scene'}
      aria-describedby="menu-note"
    >
      <span class="scene-menu__content" aria-hidden="true">
        <img
          src={withBase(imageSrc)}
          alt=""
          width="480"
          height="285"
          decoding="async"
          draggable="false"
        />
      </span>
      <span class="scene-menu__name" aria-hidden="true">
        {name}
      </span>
      <span class="scene-menu__number" aria-hidden="true">
        {number}
      </span>
    </button>
  ))}
</nav>

<style>
  .scene-menu {
    --entry-width: min(var(--menu-width), calc(100% / 3 - 12px));
    position: absolute;
    inset: 0;
  }
  .scene-menu {
    --menu-float-distance: 6px;
    --menu-float-duration: 5s;
    --menu-caption-gap: 4px;
  }
  .scene-menu__entry {
    position: absolute;
    display: grid;
    place-items: center;
    width: var(--entry-width);
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
    transform: translate(-50%, -50%);
  }
  .scene-menu__content {
    display: block;
    width: 100%;
    aspect-ratio: 1.7 / 1;
    pointer-events: none;
    animation: menu-float var(--menu-float-duration) ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }
  .scene-menu__content img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @keyframes menu-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 calc(-1 * var(--menu-float-distance));
    }
  }
  .scene-menu__name {
    position: absolute;
    top: calc(100% + var(--menu-caption-gap));
    left: 0;
    width: 100%;
    opacity: 0;
    text-align: center;
    font-size: var(--menu-font-size);
    line-height: 1.5;
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .scene-menu__entry:focus-visible .scene-menu__name {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .scene-menu__entry:hover .scene-menu__name {
      opacity: 1;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .scene-menu__name {
      opacity: 1;
    }
  }
  .scene-menu__entry:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 999px;
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-menu__content {
      animation: none;
    }
    .scene-menu__name {
      transition: none;
    }
  }
  .scene-menu__entry--experience {
    --float-delay: -0.8s;
    left: max(var(--menu-left), calc(var(--entry-width) / 2 + 6px));
    top: var(--menu-top);
  }
  .scene-menu__entry--skills {
    --float-delay: -1.7s;
    /* left: calc(var(--menu-left) + 2%); */
    left: max(var(--menu-left), calc(var(--entry-width) / 2 + 6px));
    top: var(--menu-lower);
  }
  .scene-menu__entry--interests {
    --float-delay: -3.1s;
    left: var(--menu-center, 50%);
    top: var(--menu-top);
  }
  .scene-menu__entry--projects {
    --float-delay: -2.6s;
    left: min(var(--menu-right), calc(100% - var(--entry-width) / 2 - 6px));
    top: var(--menu-top);
  }
  .scene-menu__entry--misc {
    --float-delay: -3.8s;
    /* left: calc(var(--menu-right) - 2%); */
    left: min(var(--menu-right), calc(100% - var(--entry-width) / 2 - 6px));
    /* top: calc(var(--menu-lower) + 3%); */
    top: var(--menu-lower);
  }
  .scene-menu__number {
    display: none;
  }
  .scene-menu__entry:not(.scene-menu__entry--projects)::after {
    content: '準備中';
    position: absolute;
    top: calc(100% + var(--menu-caption-gap) + 1.5em + 4px);
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    white-space: nowrap;
    opacity: 0;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .scene-menu__entry:not(.scene-menu__entry--projects):hover::after,
  .scene-menu__entry:not(.scene-menu__entry--projects):focus-visible::after {
    opacity: 1;
  }
  /* 最窄手机也保留同一排，缩小这三个入口，避免盒子相互重叠。 */
  @media (max-width: 900px) and (min-height: 521px), (max-width: 600px) {
    .scene-menu {
      --entry-width: min(var(--menu-width), calc(100% / 3 - 8px));
    }
    .scene-menu__entry {
      --menu-font-size: 12px;
      padding-inline: 4px;
      min-height: 56px;
      transform: translateX(-50%);
    }
    .scene-menu__entry--experience,
    .scene-menu__entry--skills {
      left: calc(100% / 6);
    }
    .scene-menu__entry--projects,
    .scene-menu__entry--misc {
      left: calc(100% * 5 / 6);
    }
    .scene-menu__entry--experience,
    .scene-menu__entry--interests,
    .scene-menu__entry--projects {
      top: max(0px, min(var(--menu-top), calc(100% - 400px)));
    }
    .scene-menu__entry--skills,
    .scene-menu__entry--misc {
      top: min(
        calc(100% - 168px),
        max(var(--menu-lower), calc(max(0px, min(var(--menu-top), calc(100% - 296px))) + 128px))
      );
    }
  }
</style>
