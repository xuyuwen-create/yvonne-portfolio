---
const entries = [
  {
    id: 'experience',
    name: '个人经历',
    number: '01',
    iconSrc: '/images/icons/experience.png',
  },
  {
    id: 'skills',
    name: '个人技能',
    number: '02',
    iconSrc: '/images/icons/skills.png',
  },
  {
    id: 'interests',
    name: '个人兴趣',
    number: '03',
    iconSrc: '/images/icons/interests.png',
  },
  {
    id: 'projects',
    name: '工作项目',
    number: '04',
    iconSrc: '/images/icons/projects.png',
  },
  {
    id: 'misc',
    name: '杂项',
    number: '05',
    iconSrc: '/images/icons/misc.png',
  },
];
---

<nav class="scene-menu" aria-label="作品集场景入口">
  {entries.map(({ id, name, number, iconSrc }) => (
    <button
      class={`scene-menu__entry scene-menu__entry--${id}`}
      type="button"
      data-scene={id}
      aria-controls={id === 'projects' ? 'projects-scene' : undefined}
      aria-describedby="menu-note"
    >
      <span class="scene-menu__content">
        <span class="scene-menu__icon" aria-hidden="true">
          <img src={iconSrc} alt="" width="28" height="28" decoding="async" draggable="false" />
        </span>
        <span class="scene-menu__name">{name}</span>
      </span>
      <span class="scene-menu__number" aria-hidden="true">
        {number}
      </span>
    </button>
  ))}
</nav>

<style>
  .scene-menu {
    position: absolute;
    inset: 0;
  }
  .scene-menu__entry {
    position: absolute;
    display: flex;
    align-items: center;
    width: var(--menu-width);
    min-height: 44px;
    justify-content: center;
    padding: 10px 8px;
    color: var(--color-text);
    background: #fff;
    border: 1px solid #d9d9d9;
    border-radius: 6px;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transform: translate(-50%, -50%);
  }
  .scene-menu__content {
    display: flex;
    align-items: center;
    gap: var(--menu-gap);
    padding: 3px 2px;
    background: #fff;
    border-radius: 3px;
    pointer-events: none;
    transition: transform var(--menu-pop-duration) cubic-bezier(0.22, 1.35, 0.36, 1);
  }
  /* 按钮盒子和点击范围固定，内容层弹出，避免悬停反复触发。 */
  @media (hover: hover) and (pointer: fine) {
    .scene-menu__entry:hover .scene-menu__content {
      transform: translateY(calc(-1 * var(--menu-pop-distance)));
    }
  }
  .scene-menu__entry:focus-visible .scene-menu__content {
    transform: translateY(calc(-1 * var(--menu-pop-distance)));
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-menu__content {
      transition: none;
    }
    .scene-menu__entry:hover .scene-menu__content,
    .scene-menu__entry:focus-visible .scene-menu__content {
      transform: none;
    }
    .scene-menu__entry:hover {
      border-color: #555;
    }
  }
  .scene-menu__entry:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  .scene-menu__entry--experience {
    --icon-scale: 0.94;
    left: var(--menu-left);
    top: var(--menu-upper);
  }
  .scene-menu__entry--skills {
    left: calc(var(--menu-left) + 2%);
    top: var(--menu-lower);
  }
  .scene-menu__entry--interests {
    left: var(--menu-center, 50%);
    top: var(--menu-top);
  }
  .scene-menu__entry--projects {
    --icon-scale: 0.92;
    left: var(--menu-right);
    top: calc(var(--menu-upper) + 3%);
  }
  .scene-menu__entry--misc {
    --icon-scale: 0.96;
    left: calc(var(--menu-right) - 2%);
    top: calc(var(--menu-lower) + 3%);
  }
  .scene-menu__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--icon-size);
    height: var(--icon-size);
  }
  .scene-menu__icon img {
    display: block;
    width: calc(100% * var(--icon-scale, 1));
    height: calc(100% * var(--icon-scale, 1));
    object-fit: contain;
  }
  .scene-menu__name {
    font-family: inherit;
    font-size: var(--menu-font-size);
    letter-spacing: 0.025em;
    white-space: nowrap;
  }
  .scene-menu__number {
    display: none;
  }
</style>
