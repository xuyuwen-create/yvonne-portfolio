---
import { skillGroups } from '../data/skills';
import { withBase } from '../utils/paths';
---

<section id="skills-scene" class="skills scene" aria-labelledby="skills-title" hidden inert>
  <div class="skills__content">
    <button class="skills__back" type="button" data-back-home>
      ← ホームへ
    </button>
    <p class="skills__eyebrow">実装・運用・学び</p>
    <h2 id="skills-title" tabindex="-1">
      できること
    </h2>
    <p class="skills__intro">
      Web制作やサイト運用で培ったスキルと、現在取り組んでいることをご紹介します。
    </p>
    <div class="skills__switch">
      <a
        href={withBase('/skills-collection/')}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="コレクションを開く（新しいタブで開きます）"
      >
        コレクションを開く ↗
      </a>
    </div>
    <div id="skills-text" class="skills__groups">
      {skillGroups.map((group) => (
        <section
          class:list={[
            'skills__group',
            { 'skills__group--learning': group.title === '学習・試作' },
          ]}
        >
          {group.title === '学習・試作' && <p class="skills__status">学習・試作</p>}
          <h3>{group.title === '学習・試作' ? 'React / WordPress / ACF' : group.title}</h3>
          <p>{group.description}</p>
          {group.detail && <p>{group.detail}</p>}
          {group.tools.length > 0 && (
            <ul class="skills__tools">
              {group.tools.map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills__switch {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 24px;
  }
  .skills__switch[hidden],
  .skills__groups[hidden] {
    display: none;
  }
  .skills__switch a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font: inherit;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 10px 18px;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    min-height: 44px;
  }
  .skills__switch a[aria-pressed='true'] {
    background: #e2e6f2;
    color: #242c44;
  }
  .skills__switch a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .skills {
    min-height: 0;
    overflow: auto;
    padding-block: var(--space-md);
    margin-bottom: calc(var(--page-padding) + var(--footer-height));
  }
  .skills__content {
    width: min(100%, var(--stage-width));
    margin: auto;
  }
  .skills__back {
    min-height: 44px;
    padding: var(--space-sm) 0;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .skills__back:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .skills__eyebrow {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }
  h2 {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.4;
  }
  h2:focus {
    outline: none;
  }
  .skills__intro,
  .skills__group > p {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .skills__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  .skills__group {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }
  h3 {
    font-size: 1.125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .skills__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding: 0;
    list-style: none;
    color: var(--color-accent);
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .skills__group--learning {
    grid-column: 1 / -1;
  }
  .skills__group .skills__status {
    color: var(--color-accent);
    font-size: 0.875rem;
  }
  @media (max-width: 600px) {
    .skills__groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
