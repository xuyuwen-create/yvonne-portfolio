---
const timeline = [
  {
    period: '2010.09 – 2014.06',
    title: '中国・広東財経大学｜労働関係・社会保険／法学（ダブルディグリー）',
    note: '労働関係・社会保険と法学を学び、ダブルディグリーを取得しました。働く人を支える制度や社会の仕組みについて、行政と法律の両面から学びました。',
  },
  {
    period: '2017.07.24',
    title: '来日',
    note: '大学院への進学を目指し、日本での生活を始めました。',
  },
  {
    period: '2017.07 – 2019.04',
    title: '日本語学校フジ国際語',
    note: '大学院進学を目指して来日し、日本語を学びながら受験準備に取り組みました。大学院への進学が決まり、日本語能力試験（JLPT）N1にも合格しました。',
  },
  {
    period: '2019.04 – 2021.03',
    title: '青山学院大学 国際政治経済学研究科 国際政治学専攻',
    note: '日米関係を専門とする米国出身の教授の指導のもと、AIをめぐる国際競争と協力について研究しました。授業は主に英語で受講し、修士論文も英語で執筆しました。研究や学生同士の交流を通じて、さまざまな文化や価値観に触れました。',
  },
  {
    period: '2022.03 – 2022.10',
    title: '海外IT人材の採用・マッチング支援',
    note: '海外のIT人材への経歴・希望条件のヒアリング、日本企業とのマッチング、候補者の推薦資料の作成を担当しました。外部パートナーの開拓や、海外Webサイトの日本向けローカライズ支援にも携わりました。',
  },
  {
    period: '2022.07 – 2023.04',
    title: '東京デザインプレックス研究所 WEB クリエイティブ・コース',
    note: 'Webサイトの企画・情報設計からUI/UXデザイン、デザインカンプ制作、コーディング、公開まで、一連の制作プロセスを学びました。Photoshop・Illustratorによるデザイン制作に加え、HTML・CSS・JavaScript・WordPressを使ったサイト制作に取り組みました。',
  },
  {
    period: '2023.04 – 2026.08',
    title: '株式会社エヴォワークス',
    note: 'Web制作会社でフロントエンドエンジニアとして3年以上、通信・アパレル・化粧品などの大手企業のWebサイトやLPの制作に携わりました。HTML・CSS・JavaScriptを使った実装を中心に、要件の確認からテスト、運用・保守まで担当しました。',
  },
];
---

<section
  id="experience-scene"
  class="experience scene"
  aria-labelledby="experience-title"
  hidden
  inert
>
  <div class="experience__content">
    <button class="experience__back" type="button" data-back-home>
      ← ホームへ
    </button>
    <p class="experience__eyebrow">プロフィール</p>
    <h2 id="experience-title" tabindex="-1">
      これまでの歩み
    </h2>
    <p class="experience__intro">これまでの学びや仕事についてご紹介します。</p>
    <ol class="experience__timeline">
      {timeline.map((item) => (
        <li class="experience__item">
          <p class="experience__period">{item.period}</p>
          <h3 class="experience__title">{item.title}</h3>
          <p class="experience__note">{item.note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience {
    min-height: 0;
    overflow: auto;
    padding-block: var(--space-md);
    margin-bottom: calc(var(--page-padding) + var(--footer-height));
  }
  .experience__content {
    width: min(100%, var(--stage-width));
    margin: auto;
  }
  .experience__back {
    min-height: 44px;
    padding: var(--space-sm) 0;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .experience__back:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .experience__eyebrow {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }
  #experience-title {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.4;
  }
  #experience-title:focus {
    outline: none;
  }
  .experience__intro {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .experience__timeline {
    position: relative;
    margin-top: var(--space-lg);
    padding-left: var(--space-md);
    list-style: none;
    border-left: 1px solid var(--color-border);
  }
  .experience__item {
    position: relative;
    padding-bottom: var(--space-lg);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 520ms var(--scene-easing),
      transform 520ms var(--scene-easing);
  }
  .experience__item:last-child {
    padding-bottom: 0;
  }
  .experience__item::before {
    content: '';
    position: absolute;
    top: 0.4em;
    left: calc(-1 * var(--space-md) - 5px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .experience__item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .experience__period {
    color: var(--color-accent);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }
  .experience__title {
    margin: var(--space-sm) 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .experience__note {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: reduce) {
    .experience__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('#experience-scene .experience__item');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reducedMotion.matches || !('IntersectionObserver' in window)) {
    items.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((item) => observer.observe(item));
  }
</script>
