---
import { getInterestPosts } from '../utils/wordpress';
const posts = await getInterestPosts();
---

<section
  id="interests-scene"
  class="interests scene"
  aria-labelledby="interests-title"
  hidden
  inert
>
  <div class="interests__content">
    <button class="interests__back" type="button" data-back-home>
      ← ホームへ
    </button>
    <p class="interests__eyebrow">日々のひとこま</p>
    <h2 id="interests-title" tabindex="-1">
      好きなこと
    </h2>
    <p class="interests__intro">好きなものや、日々の小さな発見を気ままに集めていきます。</p>
    {posts.length > 0 ? (
      <div class="interests__posts">
        {posts.map((post) => (
          <article class="interests__post">
            {post.image && <img src={post.image} alt={post.alt} loading="lazy" decoding="async" />}
            <h3>{post.title}</h3>
            {post.place && <p class="interests__place">{post.place}</p>}
            {post.note && <p class="interests__note">{post.note}</p>}
          </article>
        ))}
      </div>
    ) : (
      <div class="interests__empty">
        <p>まだ投稿はありません。</p>
        <p>写真やちょっとした記録を、少しずつ追加していきます。</p>
      </div>
    )}
  </div>
</section>

<style>
  .interests__posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  .interests__post {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }
  .interests__post img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--color-surface);
  }
  .interests__post h3 {
    font-size: 1.125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .interests__note,
  .interests__place {
    color: var(--color-muted);
    line-height: 1.9;
    font-size: 1rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .interests {
    min-height: 0;
    overflow: auto;
    padding-block: var(--space-md);
    margin-bottom: calc(var(--page-padding) + var(--footer-height));
  }
  .interests__content {
    width: min(100%, var(--stage-width));
    margin: auto;
  }
  .interests__back {
    min-height: 44px;
    padding: var(--space-sm) 0;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .interests__back:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .interests__eyebrow {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }
  h2 {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.4;
  }
  h2:focus {
    outline: none;
  }
  .interests__intro,
  .interests__empty p {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .interests__empty {
    margin-top: var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
</style>
