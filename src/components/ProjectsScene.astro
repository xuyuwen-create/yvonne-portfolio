  coverTitle?: string;
  coverLabel?: string;
  client?: string;
  year?: string;
  role?: string;
  kind?: string;
  team?: string;
  abstractCover?: boolean;
  linkLabel?: string;
  technologies?: string;
  url?: string;
  points?: string[];
  process?: string;
  screenshot?: string;
  imageAlt?: string;
  status?: string;
};
function availableScreenshot(path: string) {
  return existsSync(resolve(process.cwd(), 'public', path.replace(/^\//, ''))) ? path : undefined;
}
