          '構成やビジュアルの方向性を決め、Codexを活用しながら実装・動作確認・調整を進めています。人物やボタンには画像生成AIで制作した素材を使用しています。ブログはローカルのWordPressとACFで管理し、公開する投稿を書き出してAstroの静的サイトに組み込んでいます。',
        screenshot: availableScreenshot('/images/projects/personal-portfolio.webp'),
      },
    ] as Project[],
  },
];
// 调整此数组即可改变新规制作项目的展示顺序；未列出的新增项目排在末尾。
const developmentOrder = [
  'wacoal-web-limited',
  'custom-products',
  'maternity-ranking',
  'pet-travel-lp',
  'open-support',
  'brand-introduction',
  'christmas-feature',
  'eyewear-products',
  'pointback-campaign',
  'smartphone-report',
];
const developmentRanks = new Map(developmentOrder.map((id, index) => [id, index]));
// 行业分类保留为源数据；展示按工作类型分组。
const categories = [
  {
    id: 'website-development',
    name: 'Webサイト・特設ページの新規制作',
    description: 'Webサイト・LP・キャンペーンページのフロントエンド実装をご紹介します。',
    projects: sourceCategories
      .filter((category) => !['maintenance-operations', 'independent'].includes(category.id))
      .flatMap((category) => category.projects)
      .sort(
        (a, b) =>
          (developmentRanks.get(a.id ?? '') ?? developmentOrder.length) -
          (developmentRanks.get(b.id ?? '') ?? developmentOrder.length),
      ),
  },
  sourceCategories.find((category) => category.id === 'maintenance-operations')!,
  sourceCategories.find((category) => category.id === 'independent')!,
];
const workGroups = [
  {
    title: '仕事の実績',
    categories: categories.filter((category) => category.id !== 'independent'),
  },
  { title: '自主制作', categories: categories.filter((category) => category.id === 'independent') },
];
---

<section id="projects-scene" class="projects scene" aria-labelledby="projects-title" hidden inert>
  <div class="projects__content">
    <button class="projects__back" type="button" data-back-home>
      ← ホームへ
    </button>
    <p class="projects__eyebrow">制作・運用実績の一部</p>
    <h2 id="projects-title" tabindex="-1">
      制作実績
    </h2>
    <div data-category-list>
      {workGroups.map((group) => (
        <section class="projects__work-group">
          <h3 class="projects__group-heading">{group.title}</h3>
          {group.categories.map((category, index) => (
            <button
              class="projects__category"
              type="button"
              data-category={category.id}
              aria-controls={`category-${category.id}`}
            >
              <span class="projects__category-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="projects__category-name">
                {category.id === 'independent' ? 'ポートフォリオサイト' : category.name}
              </span>
              <span class="projects__category-description">{category.description}</span>
              <span class="projects__category-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </section>
      ))}
    </div>
    {categories.map((category) => (
      <div id={`category-${category.id}`} data-category-panel={category.id} hidden>
        <button class="projects__back" type="button" data-back-category>
          ← 実績一覧へ
        </button>
        <h3 class="projects__category-title" tabindex="-1">
          {category.name}
        </h3>
        <div id={`project-cards-${category.id}`}>
          {category.projects.map((project, index) => (
            <article
              class="project-card"
              data-project-card
              hidden={index !== 0}
              aria-labelledby={`project-heading-${category.id}-${index}`}
            >
              <div
                class:list={[
                  'project-card__visual',
                  { 'project-card__visual--abstract': project.abstractCover },
                ]}
              >
                <!-- 封面图暂不展示；恢复时取消下面图片渲染代码的注释。
                {project.screenshot ? (
                  <img
                    src={withBase(project.screenshot)}
                    alt={project.imageAlt ?? `${project.title}のスクリーンショット`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span>{project.status ?? 'スクリーンショット未掲載'}</span>
                )}
                -->
                {project.abstractCover ? (
                  <div class="project-card__cover-type" aria-hidden="true">
                    <span>{project.coverLabel ?? project.kind ?? '制作実績'}</span>
                    {project.coverTitle ? (
                      <strong>{project.coverTitle}</strong>
                    ) : (
                      <strong>
                        {project.title === 'WACOAL WEB Limited 2026SS' ? (
                          <>
                            WACOAL
                            <br />
                            WEB Limited
                          </>
                        ) : (
                          project.title
                        )}
                      </strong>
                    )}
                    {project.coverSeason && (
                      <span class="project-card__cover-season">{project.coverSeason}</span>
                    )}
                    {project.coverFooter && <span>{project.coverFooter}</span>}
                  </div>
                ) : (
                  <span>スクリーンショット未掲載</span>
                )}
              </div>
              <div class="project-card__copy">
                {project.status && <p class="project-card__status">{project.status}</p>}
                <h3 id={`project-heading-${category.id}-${index}`}>{project.title}</h3>
                {project.role && <p class="project-card__role">{project.role}</p>}
                <p class="project-card__description">{project.description}</p>
                <dl class="project-card__details">
                  {project.industry && (
                    <>
                      <dt>業種</dt>
                      <dd>{project.industry}</dd>
                    </>
                  )}
                  {project.client && (
                    <>
                      <dt>クライアント</dt>
                      <dd>{project.client}</dd>
                    </>
                  )}
                  {project.year && (
                    <>
                      <dt>制作年</dt>
                      <dd>{project.year}</dd>
                    </>
                  )}
                  {project.kind && (
                    <>
                      <dt>種別</dt>
                      <dd>{project.kind}</dd>
                    </>
                  )}
                  <dt>担当範囲</dt>
                  <dd>
                    <ul class="project-card__scope">
                      {project.responsibilities.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </dd>
                  {project.team && (
                    <>
                      <dt>制作体制</dt>
                      <dd>{project.team}</dd>
                    </>
                  )}
                  {project.technologies && (
                    <>
                      <dt>使用技術</dt>
                      <dd>{project.technologies}</dd>
                    </>
                  )}
                </dl>
                {project.points && (
                  <div class="project-card__notes">
                    <h4>制作のポイント</h4>
                    <ul>
                      {project.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {project.process && (
                  <div class="project-card__notes">
                    <h4>制作方法</h4>
                    <p>{project.process}</p>
                  </div>
                )}
                {project.url && (
                  <a
                    class="project-card__link"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title}：${project.linkLabel ?? 'サイトを見る'}（新しいタブで開きます）`}
                  >
                    {project.linkLabel ?? 'サイトを見る'} ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
        <nav class="projects__pagination" aria-label="制作実績の切り替え">
          <button
            type="button"
            data-project-prev
            hidden={category.projects.length <= 1}
            aria-controls={`project-cards-${category.id}`}
            disabled
          >
            前へ
          </button>
          <span data-project-page role="status" aria-live="polite" aria-atomic="true">
            01 / {String(category.projects.length).padStart(2, '0')}
          </span>
          <button
            type="button"
            data-project-next
            hidden={category.projects.length <= 1}
            disabled={category.projects.length <= 1}
            aria-controls={`project-cards-${category.id}`}
          >
            次へ
          </button>
        </nav>
      </div>
    ))}
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('#projects-scene');
  if (scene) {
    const list = scene.querySelector<HTMLElement>('[data-category-list]');
    const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-category-panel]'));
    const categoryButtons = Array.from(
      scene.querySelectorAll<HTMLButtonElement>('[data-category]'),
    );
    panels.forEach((panel) => {
      const cards = Array.from(panel.querySelectorAll<HTMLElement>('[data-project-card]'));
      const previous = panel.querySelector<HTMLButtonElement>('[data-project-prev]');
      const next = panel.querySelector<HTMLButtonElement>('[data-project-next]');
      const page = panel.querySelector<HTMLElement>('[data-project-page]');
      const title = panel.querySelector<HTMLElement>('.projects__category-title');
      const back = panel.querySelector<HTMLButtonElement>('[data-back-category]');
      const categoryButton = categoryButtons.find(
        (button) => button.dataset.category === panel.dataset.categoryPanel,
      );
      if (
        !list ||
        !previous ||
        !next ||
        !page ||
        !back ||
        !title ||
        !categoryButton ||
        !cards.length
      )
        return;
      let current = 0;
      function show(index: number) {
        if (index < 0 || index >= cards.length) return;
        current = index;
        cards.forEach((card, position) => {
          card.hidden = position !== current;
        });
        previous!.disabled = current === 0;
        next!.disabled = current === cards.length - 1;
        page!.textContent = `${String(current + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
        if (document.activeElement === previous && previous!.disabled)
          (next!.disabled ? title! : next!).focus({ preventScroll: true });
        if (document.activeElement === next && next!.disabled)
          (previous!.disabled ? title! : previous!).focus({ preventScroll: true });
      }
      categoryButton.addEventListener('click', () => {
        panels.forEach((item) => {
          item.hidden = item !== panel;
        });
        list!.hidden = true;
        show(0);
        scene!.scrollTop = 0;
        title!.focus({ preventScroll: true });
      });
      back.addEventListener('click', () => {
        panel.hidden = true;
        list!.hidden = false;
        scene!.scrollTop = 0;
        categoryButton.focus({ preventScroll: true });
      });
      previous.addEventListener('click', () => show(current - 1));
      next.addEventListener('click', () => show(current + 1));
    });
    // 每次返回首页后，下次进入制作实绩从类别列表开始。
    new MutationObserver(() => {
      if (!scene!.hidden || !list) return;
      panels.forEach((panel) => {
        panel.hidden = true;
      });
      list.hidden = false;
    }).observe(scene, { attributes: true, attributeFilter: ['hidden'] });
  }
</script>

<style>
  .projects__work-group + .projects__work-group {
    margin-top: var(--space-lg);
  }
  .projects__group-heading {
    margin: var(--space-md) 0;
    color: var(--color-accent);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .project-card__visual--abstract {
    background:
      radial-gradient(ellipse at 10% 15%, #8e75b329, transparent 65%),
      linear-gradient(145deg, var(--color-surface), var(--color-background));
  }
  .project-card__cover-type {
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    padding: var(--space-md);
    text-align: left;
    overflow-wrap: anywhere;
  }
  .project-card__cover-type > span {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }
  .project-card__cover-type strong {
    font-size: clamp(1.75rem, 3vw, 3rem);
    line-height: 1.15;
    font-weight: 700;
  }
  .project-card__cover-type .project-card__cover-season {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-text);
  }
  .project-card__copy .project-card__role {
    color: var(--color-accent);
    font-weight: 600;
  }
  .project-card__description {
    white-space: pre-line;
  }
  .project-card__scope {
    margin: 0;
    padding-left: 1.2em;
  }

  .projects {
    min-height: 0;
    overflow: auto;
    padding-block: var(--space-md);
  }
  .projects__content {
    width: min(100%, var(--stage-width));
    margin: auto;
  }
  .projects__category {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) minmax(0, 1.1fr) 1.5rem;
    align-items: baseline;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-lg) 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  [data-category-list] {
    border-top: 1px solid var(--color-text);
  }
  [data-category-list][hidden] {
    display: none;
  }
  .projects__category-name {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .projects__category-number {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .projects__category-arrow {
    justify-self: end;
    font-size: 1.25rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .projects__category:hover .projects__category-name {
      text-decoration: underline;
      text-underline-offset: 0.25em;
      text-decoration-thickness: 1px;
    }
  }
  .projects__category-description {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-muted);
  }
  .projects__category:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .projects__category-title {
    margin-block: var(--space-sm) var(--space-md);
    font-weight: 600;
  }
  .projects__category-title:focus {
    outline: none;
  }
  .projects__back {
    padding: var(--space-sm) 0;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    font-weight: 500;
  }
  .projects__back:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .projects__eyebrow {
    color: var(--color-muted);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }
  h2 {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
  }
  h2:focus {
    outline: none;
  }
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-background);
    overflow: hidden;
  }
  .project-card[hidden] {
    display: none;
  }
  .project-card__visual {
    display: grid;
    place-items: center;
    min-height: 220px;
    background: var(--color-surface);
    color: var(--color-accent);
    font-size: 0.875rem;
    padding: var(--space-md);
    text-align: center;
  }
  .project-card__copy {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: var(--space-lg);
  }
  .project-card__visual img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  h3 {
    margin-top: 0;
    font-size: 1.125rem;
    font-weight: 500;
  }
  .project-card__copy p {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.8;
  }
  .project-card__details {
    font-size: 0.875rem;
    line-height: 1.8;
    margin-block: var(--space-md);
  }
  .project-card__copy .project-card__status {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .project-card__notes {
    margin-block: var(--space-md);
    font-size: 1rem;
    line-height: 1.8;
  }
  .project-card__notes h4 {
    margin: 0 0 var(--space-sm);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .project-card__notes ul {
    margin: 0;
    padding-left: 1.25em;
    color: var(--color-muted);
  }
  .project-card__details dt {
    font-weight: 600;
  }
  .project-card__details dd {
    margin: 0 0 var(--space-sm);
    color: var(--color-muted);
  }
  .project-card__link {
    color: var(--color-accent);
    font-size: 0.875rem;
    text-underline-offset: 4px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .projects__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
    font-size: 0.875rem;
  }
  .projects__pagination button {
    font: inherit;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
  }
  .projects__pagination button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .projects__pagination button[hidden] {
    display: none;
  }
  .projects__pagination button:focus-visible,
  .project-card__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .projects__category {
      grid-template-columns: 1.5rem minmax(0, 1fr) 1.25rem;
      gap: var(--space-sm);
      padding-block: var(--space-md);
    }
    .projects__category-description {
      grid-column: 2;
      grid-row: 2;
    }
    .projects__category-arrow {
      grid-column: 3;
      grid-row: 1;
    }
    .project-card {
      grid-template-columns: 1fr;
    }
    .project-card__visual {
      min-height: 120px;
    }
    .project-card__copy {
      padding: var(--space-md);
    }
  }
</style>
