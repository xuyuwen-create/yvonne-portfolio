---

<section id="projects-scene" class="projects scene" aria-labelledby="projects-title" hidden inert>
  <div class="projects__content">
    <button class="projects__back" type="button" data-back-home>
      ← ホームへ
    </button>
    <p class="projects__eyebrow">コーディング実績 一部</p>
    <h2 id="projects-title" tabindex="-1">
      制作実績
    </h2>
    <div data-category-list>
      {categories.map((category, index) => (
        <button
          class="projects__category"
          type="button"
          data-category={category.id}
          aria-controls={`category-${category.id}`}
        >
          <span class="projects__category-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="projects__category-name">{category.name}</span>
          <span class="projects__category-description">{category.description}</span>
          <span class="projects__category-arrow" aria-hidden="true">
            ↗
          </span>
        </button>
      ))}
    </div>
    {categories.map((category) => (
      <div id={`category-${category.id}`} data-category-panel={category.id} hidden>
        <button class="projects__back" type="button" data-back-category>
          ← カテゴリ一覧へ
        </button>
        <h3 class="projects__category-title" tabindex="-1">
          {category.name}
        </h3>
        <div id={`project-cards-${category.id}`}>
          {category.projects.map((project, index) => (
            <article
              class="project-card"
              data-project-card
              hidden={index !== 0}
              aria-labelledby={`project-heading-${category.id}-${index}`}
            >
              <div
                class:list={[
                  'project-card__visual',
                  { 'project-card__visual--abstract': project.abstractCover },
                ]}
              >
                <!-- 封面图暂不展示；恢复时取消下面图片渲染代码的注释。
                {project.screenshot ? (
                  <img
                    src={withBase(project.screenshot)}
                    alt={project.imageAlt ?? `${project.title}のスクリーンショット`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span>{project.status ?? 'スクリーンショット未掲載'}</span>
                )}
                -->
                {project.abstractCover ? (
                  <div class="project-card__cover-type" aria-hidden="true">
                    <span>{project.coverLabel ?? 'CAMPAIGN WEBSITE / 2026'}</span>
                    {project.coverTitle ? (
                      <strong>{project.coverTitle}</strong>
                    ) : (
                      <strong>
                        WACOAL
                        <br />
                        WEB Limited
                      </strong>
                    )}
                    {project.coverTitle ? (
                      <span>MAINTENANCE / FRONTEND</span>
                    ) : (
                      <>
                        <span class="project-card__cover-season">2026SS</span>
                        <span>FRONTEND IMPLEMENTATION</span>
                      </>
                    )}
                  </div>
                ) : (
                  <span>スクリーンショット未掲載</span>
                )}
              </div>
              <div class="project-card__copy">
                {project.status && <p class="project-card__status">{project.status}</p>}
                <h3 id={`project-heading-${category.id}-${index}`}>{project.title}</h3>
                {project.role && <p class="project-card__role">{project.role}</p>}
                <p class="project-card__description">{project.description}</p>
                <dl class="project-card__details">
                  {project.industry && (
                    <>
                      <dt>業種</dt>
                      <dd>{project.industry}</dd>
                    </>
                  )}
                  {project.client && (
                    <>
                      <dt>クライアント</dt>
                      <dd>{project.client}</dd>
                    </>
                  )}
                  {project.year && (
                    <>
                      <dt>制作年</dt>
                      <dd>{project.year}</dd>
                    </>
                  )}
                  {project.kind && (
                    <>
                      <dt>種別</dt>
                      <dd>{project.kind}</dd>
                    </>
                  )}
                  <dt>担当範囲</dt>
                  <dd>
                    <ul class="project-card__scope">
                      {project.responsibilities.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </dd>
                  {project.team && (
                    <>
                      <dt>制作体制</dt>
                      <dd>{project.team}</dd>
                    </>
                  )}
                  {project.technologies && (
                    <>
                      <dt>使用技術</dt>
                      <dd>{project.technologies}</dd>
                    </>
                  )}
                </dl>
                {project.points && (
                  <div class="project-card__notes">
                    <h4>制作のポイント</h4>
                    <ul>
                      {project.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {project.process && (
                  <div class="project-card__notes">
                    <h4>制作方法</h4>
                    <p>{project.process}</p>
                  </div>
                )}
                {project.url && (
                  <a
                    class="project-card__link"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title}：${project.linkLabel ?? 'サイトを見る'}（新しいタブで開きます）`}
                  >
                    {project.linkLabel ?? 'サイトを見る'} ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
        <nav class="projects__pagination" aria-label="制作実績の切り替え">
          <button
            type="button"
            data-project-prev
            hidden={category.projects.length <= 1}
            aria-controls={`project-cards-${category.id}`}
            disabled
          >
            前へ
          </button>
          <span data-project-page role="status" aria-live="polite" aria-atomic="true">
            01 / {String(category.projects.length).padStart(2, '0')}
          </span>
          <button
            type="button"
            data-project-next
            hidden={category.projects.length <= 1}
            disabled={category.projects.length <= 1}
            aria-controls={`project-cards-${category.id}`}
          >
            次へ
          </button>
        </nav>
      </div>
    ))}
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('#projects-scene');
  if (scene) {
    const list = scene.querySelector<HTMLElement>('[data-category-list]');
    const panels = Array.from(scene.querySelectorAll<HTMLElement>('[data-category-panel]'));
    const categoryButtons = Array.from(
      scene.querySelectorAll<HTMLButtonElement>('[data-category]'),
    );
    panels.forEach((panel) => {
      const cards = Array.from(panel.querySelectorAll<HTMLElement>('[data-project-card]'));
      const previous = panel.querySelector<HTMLButtonElement>('[data-project-prev]');
      const next = panel.querySelector<HTMLButtonElement>('[data-project-next]');
      const page = panel.querySelector<HTMLElement>('[data-project-page]');
      const title = panel.querySelector<HTMLElement>('.projects__category-title');
      const back = panel.querySelector<HTMLButtonElement>('[data-back-category]');
      const categoryButton = categoryButtons.find(
        (button) => button.dataset.category === panel.dataset.categoryPanel,
      );
      if (
        !list ||
        !previous ||
        !next ||
        !page ||
        !back ||
        !title ||
        !categoryButton ||
        !cards.length
      )
        return;
      let current = 0;
      function show(index: number) {
        if (index < 0 || index >= cards.length) return;
        current = index;
        cards.forEach((card, position) => {
          card.hidden = position !== current;
        });
        previous!.disabled = current === 0;
        next!.disabled = current === cards.length - 1;
        page!.textContent = `${String(current + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
        if (document.activeElement === previous && previous!.disabled)
          (next!.disabled ? title! : next!).focus({ preventScroll: true });
        if (document.activeElement === next && next!.disabled)
          (previous!.disabled ? title! : previous!).focus({ preventScroll: true });
      }
      categoryButton.addEventListener('click', () => {
        panels.forEach((item) => {
          item.hidden = item !== panel;
        });
        list!.hidden = true;
        show(0);
        scene!.scrollTop = 0;
        title!.focus({ preventScroll: true });
      });
      back.addEventListener('click', () => {
        panel.hidden = true;
        list!.hidden = false;
        scene!.scrollTop = 0;
        categoryButton.focus({ preventScroll: true });
      });
      previous.addEventListener('click', () => show(current - 1));
      next.addEventListener('click', () => show(current + 1));
    });
    // 每次返回首页后，下次进入制作实绩从类别列表开始。
    new MutationObserver(() => {
      if (!scene!.hidden || !list) return;
      panels.forEach((panel) => {
        panel.hidden = true;
      });
      list.hidden = false;
    }).observe(scene, { attributes: true, attributeFilter: ['hidden'] });
